<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>V60 | Coffee Brew Lab</title>

    <link rel="stylesheet" href="app.css">

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

</head>

<body>

    <header class="topbar">

        <a href="index.html">← Inicio</a>

        <h1>☕ V60</h1>

    </header>

    <!-- KPIs -->

    <section class="kpis">

        <div class="kpi">
            <h2 id="kpiPreparaciones">0</h2>
            <p>Preparaciones</p>
        </div>

        <div class="kpi">
            <h2 id="kpiPromedio">0:00</h2>
            <p>Tiempo Medio</p>
        </div>

        <div class="kpi">
            <h2 id="kpiCafe">0g</h2>
            <p>Café Promedio</p>
        </div>

        <div class="kpi">
            <h2 id="kpiAgua">0ml</h2>
            <p>Agua Promedio</p>
        </div>

    </section>

    <!-- DATOS -->

    <section class="card">

        <h2>Receta V60</h2>

        <select id="cafeSeleccionado">
            <option value="">Seleccionar Café</option>
        </select>

        <input type="number" id="cafe" placeholder="Café (g)" value="15">

        <input type="number" id="agua" placeholder="Agua (ml)" value="250">

        <input type="number" id="temperatura" placeholder="Temperatura °C" value="92">

        <input type="number" id="ratio" placeholder="Ratio" value="16">

    </section>

    <!-- ESTADO -->

    <section class="card">

        <h2>Extracción Guiada</h2>

        <h3 id="faseActual">
            Listo para comenzar
        </h3>

        <div id="cronometro" class="cronometro">

            00:00

        </div>

        <div class="progress">
            <div id="progressBar" class="progress-bar">
            </div>
        </div>

        <button onclick="iniciarV60()">
            ▶ Iniciar Extracción
        </button>

        <br><br>

        <button onclick="detenerV60()">
            ■ Detener
        </button>

    </section>

    <!-- GUÍA -->

    <section class="card">

        <h2>Guía Automática</h2>

        <div id="timeline">

            <p>🌱 Bloom: 0 - 30 s</p>

            <p>💧 Vertido 1: 30 - 60 s</p>

            <p>💧 Vertido 2: 60 - 120 s</p>

            <p>💧 Vertido Final: 120 - 180 s</p>

            <p>✅ Finalización: 180 s</p>

        </div>

    </section>

    <!-- GUARDAR -->

    <section class="card">

        <button onclick="guardarPreparacion()">

            Guardar Preparación

        </button>

    </section>

    <!-- GRÁFICO -->

    <section class="card">

        <h2>📈 Consistencia</h2>

        <canvas id="graficoV60"></canvas>

    </section>

    <!-- HISTORIAL -->

    <section class="card">

        <h2>📋 Historial</h2>

        <div id="historial"></div>

    </section>

    <script>

        let intervaloV60;
        let inicioV60;
        let grafico;

        const preparaciones =
            JSON.parse(
                localStorage.getItem("v60Preparaciones")
            ) || [];

        if (typeof cargarSelectCafes === "function") {
            cargarSelectCafes("cafeSeleccionado");
        }

        function iniciarV60() {

            clearInterval(intervaloV60);

            inicioV60 = Date.now();

            intervaloV60 = setInterval(() => {

                const segundos = Math.floor(
                    (Date.now() - inicioV60) / 1000
                );

                mostrarTiempo(segundos);

                actualizarFase(segundos);

            }, 1000);

        }

        function detenerV60() {

            clearInterval(intervaloV60);

        }

        function mostrarTiempo(segundos) {

            let min =
                Math.floor(segundos / 60);

            let seg =
                segundos % 60;

            document.getElementById(
                "cronometro"
            ).innerText =

                String(min).padStart(2, "0")
                + ":"
                +
                String(seg).padStart(2, "0");

            const progreso =
                Math.min(
                    (segundos / 180) * 100,
                    100
                );

            document.getElementById(
                "progressBar"
            ).style.width =
                progreso + "%";

        }

        function actualizarFase(segundos) {

            const fase =
                document.getElementById(
                    "faseActual"
                );

            if (segundos < 30) {

                fase.innerHTML =
                    "🌱 Bloom";

            }

            else if (segundos < 60) {

                fase.innerHTML =
                    "💧 Vertido 1";

            }

            else if (segundos < 120) {

                fase.innerHTML =
                    "💧 Vertido 2";

            }

            else if (segundos < 180) {

                fase.innerHTML =
                    "💧 Vertido Final";

            }

            else {

                fase.innerHTML =
                    "✅ Extracción Finalizada";

                clearInterval(
                    intervaloV60
                );

                alert(
                    "✅ V60 Finalizado"
                );

            }

        }

        function guardarPreparacion() {

            const tiempoTexto =
                document.getElementById(
                    "cronometro"
                ).innerText;

            const registro = {

                id: Date.now(),

                fecha:
                    new Date()
                        .toLocaleString(),

                cafe:
                    document.getElementById(
                        "cafeSeleccionado"
                    ).value,

                gramos:
                    document.getElementById(
                        "cafe"
                    ).value,

                agua:
                    document.getElementById(
                        "agua"
                    ).value,

                temperatura:
                    document.getElementById(
                        "temperatura"
                    ).value,

                ratio:
                    document.getElementById(
                        "ratio"
                    ).value,

                tiempo:
                    tiempoTexto

            };

            preparaciones.push(
                registro
            );

            localStorage.setItem(

                "v60Preparaciones",

                JSON.stringify(
                    preparaciones
                )

            );

            renderHistorial();

            actualizarKPIS();

            actualizarGrafico();

            alert(
                "✅ Preparación guardada"
            );

        }

        function renderHistorial() {

            document.getElementById(
                "historial"
            ).innerHTML =

                [...preparaciones]
                    .reverse()
                    .map(p => `

    <div class="registro">

        <h3>☕ ${p.cafe || "Sin café"}</h3>

        <p>⚖️ ${p.gramos} g</p>

        <p>💧 ${p.agua} ml</p>

        <p>🌡️ ${p.temperatura} °C</p>

        <p>📊 1:${p.ratio}</p>

        <p>⏱️ ${p.tiempo}</p>

        <p>${p.fecha}</p>

    </div>

    `).join("");

        }

        function actualizarKPIS() {

            document.getElementById(
                "kpiPreparaciones"
            ).innerText =
                preparaciones.length;

            if (preparaciones.length === 0)
                return;

            let sumaCafe = 0;

            let sumaAgua = 0;

            let sumaSegundos = 0;

            preparaciones.forEach(p => {

                sumaCafe +=
                    Number(p.gramos);

                sumaAgua +=
                    Number(p.agua);

                const partes =
                    p.tiempo.split(":");

                sumaSegundos +=

                    Number(partes[0]) * 60 +

                    Number(partes[1]);

            });

            document.getElementById(
                "kpiCafe"
            ).innerText =

                (
                    sumaCafe /
                    preparaciones.length
                ).toFixed(1)
                + "g";

            document.getElementById(
                "kpiAgua"
            ).innerText =

                Math.round(
                    sumaAgua /
                    preparaciones.length
                )
                + "ml";

            const promedio =
                Math.round(

                    sumaSegundos /
                    preparaciones.length

                );

            const min =
                Math.floor(
                    promedio / 60
                );

            const seg =
                promedio % 60;

            document.getElementById(
                "kpiPromedio"
            ).innerText =

                String(min).padStart(2, "0")
                + ":"
                +
                String(seg).padStart(2, "0");

        }

        function actualizarGrafico() {

            const canvas =
                document.getElementById(
                    "graficoV60"
                );

            const datos =
                preparaciones.map(p => {

                    const partes =
                        p.tiempo.split(":");

                    return (

                        Number(partes[0]) * 60 +

                        Number(partes[1])

                    );

                });

            if (grafico) {

                grafico.destroy();

            }

            grafico = new Chart(

                canvas,

                {

                    type: "line",

                    data: {

                        labels:
                            datos.map(
                                (_, i) => `#${i + 1}`
                            ),

                        datasets: [{

                            label: "Tiempo extracción",

                            data: datos,

                            borderColor: "#c58b45",

                            fill: false,

                            tension: .3

                        }]

                    }

                });

        }

        renderHistorial();
        actualizarKPIS();
        actualizarGrafico();

    </script>

</body>

</html>